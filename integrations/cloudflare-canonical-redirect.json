{
  "description": "MindAgo exact-host canonical redirect",
  "expression": "(http.host eq \"www.mindago.my\") or (http.host eq \"mindago.my\" and not ssl)",
  "action": "redirect",
  "action_parameters": {
    "from_value": {
      "status_code": 301,
      "target_url": { "expression": "concat(\"https://mindago.my\", http.request.uri.path)" },
      "preserve_query_string": true
    }
  },
  "enabled": true
}
